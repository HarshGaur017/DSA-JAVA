//Shallow Copy means the nested object still holds the reference it is not still fully cloned or copied only copied first level of object.
const user = {
    name: "Rahul",
    address: {city: "Delhi"}
};

const copy = {...user};

copy.address.city = "Mumbai";
copy.name = "harsh"

console.log(user, copy);

//Deep copy fully structred copies the entire object or clones the entire object.
const deepCopy = JSON.parse(JSON.stringify(user));

deepCopy.name = "Shubham";
deepCopy.address.city = "Uttar Pradesh";

console.log(user);
console.log(deepCopy);

function bankAccount() {
    let balance = 0
    
    return {
        deposit(amount){
            balance+=amount;
        },
        getBalance() {
            return balance
        }
    }
}

const account = bankAccount();
account.deposit(100);
account.deposit(500);

console.log(account.getBalance());

